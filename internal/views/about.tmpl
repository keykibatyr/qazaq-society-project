
{{ define "content" }}
<div class="py-20 max-w-6xl mx-auto px-4">
  <h1 class="text-3xl font-bold text-center text-blue-900">Our Team {{.Title}}</h1>

  <div class="mt-12 grid gap-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">

    <div class="bg-white shadow rounded-xl overflow-hidden">
      <img src="/assets/images/Amirlan.jpeg" class="h-64 w-full object-cover">
      <div class="p-6 text-center">
        <h3 class="text-lg font-semibold">President</h3>
        <p class="text-blue-600 font-semibold mt-2">Amirlan Nurbalin</p>
      </div>
    </div>

    <div class="bg-white shadow rounded-xl overflow-hidden">
      <img src="/assets/images/Nazgul.jpeg" class="h-64 w-full object-cover">
      <div class="p-6 text-center">
        <h3 class="text-lg font-semibold">Vice President</h3>
        <p class="text-blue-600 font-semibold mt-2">Nazgul Nurgali</p>
      </div>
    </div>

    <div class="bg-white shadow rounded-xl overflow-hidden">
      <img src="/assets/images/Armanzhan.jpeg" class="h-64 w-full object-cover">
      <div class="p-6 text-center">
        <h3 class="text-lg font-semibold">Executive Director</h3>
        <p class="text-blue-600 mt-2 font-semibold">Armanzhan Narbekov</p>
      </div>
    </div>

  </div>
</div>
{{ end }}

{{ template "layout" . }}