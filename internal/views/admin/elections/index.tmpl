{{ define "title" }}Elections{{ end }}

{{ define "content" }}
<div class="py-16 max-w-6xl mx-auto px-4">

  <div class="flex items-center justify-between mb-10">
    <h1 class="text-2xl font-semibold text-gray-900">Elections</h1>

    <a href="/admin/elections/new"
      class="px-4 py-2 rounded-md text-sm font-semibold bg-blue-600 text-white hover:bg-blue-700 transition">
      + New Election
    </a>
  </div>

  {{ if not .Elections }}
    <p class="text-gray-600">No elections created yet.</p>
  {{ else }}

  <div class="space-y-8">
    {{ range .Elections }}

    <article class="bg-white rounded-xl shadow p-6">

      <!-- Header -->
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-semibold text-gray-900">{{ .Title }}</h2>

          <p class="text-sm text-gray-600 mt-1">
            {{ .StartDay }} {{ .StartMonth }} {{ .StartTime }}
            →
            {{ .EndDay }} {{ .EndMonth }} {{ .EndTime }}
          </p>
        </div>

        <div class="flex gap-3">
          <a href="/admin/elections/{{ .ID }}/results"
             class="text-blue-600 hover:underline text-sm">
            View Results
          </a>
        </div>
      </div>

      <!-- Published Status -->
      <div class="flex items-center gap-3">
        {{ if .Published }}
        <form action = "/admin/elections/{{ .ID }}/unpublish" method = "POST">
          <span class="text-green-700 text-sm font-semibold">Published</span>
            <button class="text-orange-600 hover:underline font-medium text-sm">
              Unpublish
            </button>
        </form>
        {{ else }}
        <form action = "/admin/elections/{{ .ID }}/publish" method = "POST">
          <span class="text-green-700 text-sm font-semibold">Unpublished</span>
            <button class="text-orange-600 hover:underline font-medium text-sm">
              Publish
            </button>
        {{ end }}
      </div>

    </article>

    {{ end }}
  </div>

  {{ end }}
</div>
{{ end }}
