{{ define "title" }}Elections{{ end }}

{{ define "content" }}
<div class="py-16 max-w-5xl mx-auto px-4">

  <h1 class="text-3xl font-semibold mb-10">Available Elections</h1>

  {{ if not .Elections }}
    <p class="text-gray-600">No elections available at the moment.</p>
  {{ else }}

  <div class="space-y-6">

    {{ range .Elections }}
    <a href="/user/elections/{{ .ID }}" 
       class="block bg-white shadow rounded-xl p-6 hover:shadow-md transition">

      <div class="flex justify-between items-center">
        <div>
          <h2 class="text-xl font-semibold text-gray-900">{{ .Title }}</h2>

          <p class="text-gray-600 text-sm">
            {{ .StartDay }} {{ .StartMonth }} {{ .StartTime }}
            →
            {{ .EndDay }} {{ .EndMonth }} {{ .EndTime }}
          </p>
        </div>

        <span class="text-blue-600 font-semibold text-sm">Vote</span>
      </div>

    </a>
    {{ end }}

  </div>

  {{ end }}
</div>
{{ end }}
