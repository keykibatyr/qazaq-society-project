{{ define "content" }}
<div class="py-20 max-w-5xl mx-auto px-4">

  <h1 class="text-3xl font-bold text-center text-blue-900">
    Recent Events
  </h1>

  {{ if not .Events }}
  <p class="text-center text-gray-600 mt-10">No events available.</p>
  {{ else }}

  <div class="mt-10 space-y-10">
    {{ range .Events }}

    {{ if .Published }}

    <article class="bg-white rounded-xl shadow overflow-hidden">

      <!-- Event image -->
      {{ if .ImageURL }}
      <img src="/{{ .ImageURL }}" class="w-full h-64 object-cover" alt="Event image">
      {{ end }}

      <div class="p-6 flex flex-col md:flex-row gap-6">

        <!-- Date block -->
        <div class="bg-blue-600 text-white rounded-lg p-4 text-center min-w-[100px]">
          <div class="text-2xl font-bold">{{ .Day }}</div>
          <div class="text-sm uppercase">{{ .Month }}</div>
          <div class="text-sm text-white-600">
            Starts at: {{ .Time }}
          </div>
        </div>

        <!-- Title + Description -->
        <div class="flex-1">
          <h2 class="text-xl font-semibold text-blue-900">
            {{ .Title }}
          </h2>

          {{ if .Description }}
          <p class="text-gray-700 mt-2">
            {{ .Description }}
          </p>
          {{ end }}

          {{ if .Location }}
          <p class="text-gray-600 mt-2 font-medium">
            Location: {{ .Location }}
          </p>
          {{ end }}
        </div>

      </div>
    </article>

    {{ end }}


    {{ end }}
  </div>

  {{ end }}


</div>
{{ end }}

{{ template "layout" . }}