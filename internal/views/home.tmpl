
{{ define "content" }}
<!-- Hero -->
  <section
    class="relative flex min-h-[80vh] items-start justify-center bg-[url('/assets/images/main-photo.jpeg')] bg-cover bg-center py-[6rem] pt-[8vh] text-white overflow-hidden">
    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/50 to-black/70"></div>

    <div class="relative z-[1] w-full max-w-container mx-auto px-5">
      <div class="mx-auto max-w-[800px] text-center">
        <h1
          class="mt-0 pt-8 text-[3.5rem] leading-[1.2] font-bold text-white mb-4 drop-shadow-[2px_2px_4px_rgba(0,0,0,0.5)]"
        >
          Welcome to Qazaq Society in Belgium
        </h1>
        <p
          class="mx-auto max-w-[800px] px-5 text-[1.5rem] leading-[1.7] mb-4 font-bold text-white/95 drop-shadow-[1px_1px_3px_rgba(0,0,0,0.5)]"
        >
          Connecting the Kazakh community through culture, language, and shared experiences
        </p>
        <div
          class="mt-[26rem] flex flex-wrap justify-center gap-5 px-5 pt-4 md:mt-[26rem] xs:flex-col md:flex-row"
        >
          <a
            href="#events"
            class="inline-block rounded-pill border-2 border-primary bg-primary px-7 py-3 text-[0.9rem] font-semibold uppercase tracking-[0.5px] text-white transition-all duration-300 hover:bg-transparent hover:text-primary"
          >
            Upcoming Events
          </a>
          <a
            href="#join"
            class="inline-block rounded-pill border-2 border-primary bg-primary px-7 py-3 text-[0.9rem] font-semibold uppercase tracking-[0.5px] text-white transition-all duration-300 hover:bg-transparent hover:text-primary"
          >
            Join Our Community
          </a>
        </div>
      </div>
    </div>
  </section>



 <!-- Services -->
  <section id="services" class="py-24">
    <div class="w-full max-w-container mx-auto px-5">
      <div class="mb-16 text-center">
        <h2 class="mb-6 text-[2.25rem] font-bold leading-[1.2] text-darkBlue">
          What Do We Provide
        </h2>
        <div
          class="mx-auto h-1 w-20 rounded bg-gradient-to-r from-primary to-secondary"
        ></div>
      </div>

      <div class="mt-12 grid gap-[30px] grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        <!-- Card 1 -->
        <div
          class="rounded-main border-t-[4px] border-primary bg-white px-8 py-10 text-center shadow-card transition-all duration-300 hover:-translate-y-[10px] hover:shadow-[0_10px_30px_rgba(0,0,0,0.1)]"
        >
          <div
            class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-lightBlue text-[2rem] text-primary transition-all duration-300"
          >
            <i class="fas fa-calendar-alt"></i>
          </div>
          <h3 class="mb-5 text-[1.5rem] font-bold text-darkBlue">
            Cultural Celebrations
          </h3>
          <p class="mb-0 text-[1.05rem] leading-[1.7] text-textColor">
            Events like Nauryz, Kazakh food fairs, traditional music and dance performances.
          </p>
        </div>

        <!-- Card 2 -->
        <div
          class="rounded-main border-t-[4px] border-primary bg-white px-8 py-10 text-center shadow-card transition-all duration-300 hover:-translate-y-[10px] hover:shadow-[0_10px_30px_rgba(0,0,0,0.1)]"
        >
          <div
            class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-lightBlue text-[2rem] text-primary transition-all duration-300"
          >
            <i class="fas fa-language"></i>
          </div>
          <h3 class="mb-5 text-[1.5rem] font-bold text-darkBlue">
            Language &amp; Literature
          </h3>
          <p class="mb-0 text-[1.05rem] leading-[1.7] text-textColor">
            Beginner and intermediate Kazakh classes, conversation circles, and literature reading nights.
          </p>
        </div>

        <!-- Card 3 -->
        <div
          class="rounded-main border-t-[4px] border-primary bg-white px-8 py-10 text-center shadow-card transition-all duration-300 hover:-translate-y-[10px] hover:shadow-[0_10px_30px_rgba(0,0,0,0.1)]"
        >
          <div
            class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-full bg-lightBlue text-[2rem] text-primary transition-all duration-300"
          >
            <i class="fas fa-graduation-cap"></i>
          </div>
          <h3 class="mb-5 text-[1.5rem] font-bold text-darkBlue">
            Workshops
          </h3>
          <p class="mb-0 text-[1.05rem] leading-[1.7] text-textColor">
            Topics such as Kazakh history, crafts, cooking, and career preparation workshops.
          </p>
        </div>
      </div>
    </div>
  </section>

<!-- Events preview -->
 <section
    id="events"
    class="relative overflow-hidden bg-cover bg-center py-[100px] text-center text-white"
    style="background-image: url('{{ .ImageURL }}')"
  >
    <!-- dark overlay -->
    <div class="absolute inset-0 bg-black/50"></div>

    <div class="relative z-[2] w-full max-w-container mx-auto px-5">
      <div class="mb-16 text-center">
        <h2 class="mb-6 text-[2.25rem] font-bold leading-[1.2] text-white drop-shadow-[0_2px_4px_rgba(0,0,0,0.3)]">
          Events
        </h2>
        <div
          class="mx-auto h-1 w-20 rounded bg-secondary"
        ></div>
      </div>

      <div
        class="relative z-[2] mx-auto mb-6 flex max-w-eventCard items-center rounded-card bg-white/90 px-6 py-6 text-left shadow-event md:flex-row flex-col md:text-left text-center"
      >
        <div
          class="mb-4 min-w-[80px] rounded-[8px] bg-primary px-4 py-[15px] text-center text-white md:mb-0 md:mr-5"
        >
          <span class="block text-[2rem] font-bold leading-none">{{.Day}}</span>
          <span class="mt-1 text-[1rem] tracking-[1px] uppercase">{{.Month}}</span>
        </div>
        <div class="flex-1">
          <h3 class="mb-2 text-[1.4rem] font-bold text-darkBlue">
            {{.Title}}
          </h3>
          <p class="mb-[5px] flex items-center justify-center gap-2 text-[0.95rem] text-darkGray md:justify-start">
            <i class="far fa-clock text-primary w-5 text-center"></i>
            {{.Time}}
          </p>
          <p class="mb-[5px] flex items-center justify-center gap-2 text-[0.95rem] text-darkGray md:justify-start">
            <i class="fas fa-map-marker-alt text-primary w-5 text-center"></i>
            Embassy of Kazakhstan in Belgum, Brussels
          </p>
          <a
            href="/events"
            class="mt-4 inline-block rounded-pill border-2 border-primary bg-primary px-5 py-2 text-[0.8rem] font-semibold uppercase tracking-[0.5px] text-white transition-all duration-300 hover:bg-transparent hover:text-primary"
          >
            Learn More
          </a>
        </div>
      </div>

      <div class="relative z-[2] text-center">
        <a
          href="events.html"
          class="inline-block rounded-pill border-2 border-white bg-transparent px-7 py-3 text-[0.9rem] font-semibold uppercase tracking-[0.5px] text-white transition-all duration-300 hover:bg-white hover:text-primary"
        >
          View All Events
        </a>
      </div>
    </div>
  </section>


<!-- About preview -->
<!-- About / Timeline -->
  <section id="about" class="py-24">
    <div class="w-full max-w-container mx-auto px-5">
      <div class="grid grid-cols-1 gap-12 items-center">
        <div>
          <div class="mb-16 text-center">
            <h2 class="mb-6 text-[2.25rem] font-bold leading-[1.2] text-darkBlue">
              Our Story
            </h2>
            <div
              class="mx-auto h-1 w-20 rounded bg-gradient-to-r from-primary to-secondary"
            ></div>
          </div>

          <div class="relative mx-auto max-w-[800px] px-5">
            <!-- central line -->
            <div
              class="pointer-events-none absolute inset-y-0 left-10 w-[2px] bg-primary lg:left-1/2 lg:-translate-x-1/2"
            ></div>

            <!-- Item 1 -->
            <div class="relative mb-12 w-full lg:w-1/2 lg:pr-10 lg:text-right">
              <div
                class="absolute top-0 right-[-40px] flex h-20 w-20 items-center justify-center rounded-full bg-primary text-[1.25rem] font-bold text-white shadow-timelineYear lg:right-[-40px]"
              >
                2023
              </div>
              <div
                class="relative rounded-main bg-white p-8 shadow-card"
              >
                <!-- arrow -->
                <div
                  class="absolute top-[30px] right-[-10px] h-0 w-0 border-y-[10px] border-l-[10px] border-y-transparent border-l-white drop-shadow-[2px_0_2px_rgba(0,0,0,0.1)] lg:block hidden"
                ></div>
                <h4 class="mb-4 text-[1.5rem] font-bold text-darkBlue">
                  First Group Trip to Brugge
                </h4>
                <p class="mb-0 text-[1.05rem] leading-[1.7] text-textColor">
                  First group trip to Brugge planned by Kazakh Society.
                </p>
              </div>
            </div>

            <!-- Item 2 -->
            <div class="relative mb-12 w-full lg:ml-auto lg:w-1/2 lg:pl-10">
              <div
                class="absolute top-0 left-[-40px] flex h-20 w-20 items-center justify-center rounded-full bg-primary text-[1.25rem] font-bold text-white shadow-timelineYear"
              >
                2024
              </div>
              <div
                class="relative rounded-main bg-white p-8 shadow-card"
              >
                <!-- arrow -->
                <div
                  class="absolute top-[30px] left-[-10px] h-0 w-0 border-y-[10px] border-r-[10px] border-y-transparent border-r-white drop-shadow-[-2px_0_2px_rgba(0,0,0,0.1)] lg:block hidden"
                ></div>
                <h4 class="mb-4 text-[1.5rem] font-bold text-darkBlue">
                  First Joint Nauryz Celebration
                </h4>
                <p class="mb-0 text-[1.05rem] leading-[1.7] text-textColor">
                  Successfully organized with multiple Central Asian societies at KU Leuven.
                </p>
              </div>
            </div>

            <!-- Item 3 -->
            <div class="relative mb-12 w-full lg:w-1/2 lg:pr-10 lg:text-right">
              <div
                class="absolute top-0 right-[-40px] flex h-20 w-20 items-center justify-center rounded-full bg-primary text-[1.25rem] font-bold text-white shadow-timelineYear lg:right-[-40px]"
              >
                2025
              </div>
              <div
                class="relative rounded-main bg-white p-8 shadow-card"
              >
                <!-- arrow -->
                <div
                  class="absolute top-[30px] right-[-10px] h-0 w-0 border-y-[10px] border-l-[10px] border-y-transparent border-l-white drop-shadow-[2px_0_2px_rgba(0,0,0,0.1)] lg:block hidden"
                ></div>
                <h4 class="mb-4 text-[1.5rem] font-bold text-darkBlue">
                  Expanded Reach
                </h4>
                <p class="mb-0 text-[1.05rem] leading-[1.7] text-textColor">
                  Growth of membership across Brussels and Leuven with an expanded language program.
                </p>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section>

<section id="join" class="bg-primary py-24 text-white">
    <div class="w-full max-w-container mx-auto px-5">
      <div class="mx-auto max-w-[1000px] text-center">
        <h2 class="mb-6 text-[2.5rem] font-bold leading-[1.2] text-white">
          Become Part of Our Community
        </h2>
        <div
          class="mx-auto h-1 w-20 rounded bg-secondary"
        ></div>
        <p class="mx-auto mb-16 mt-6 max-w-[700px] text-[1.25rem] leading-[1.7] opacity-90">
          Join us in celebrating Kazakh culture and building meaningful connections
        </p>

        <div
          class="mt-12 grid grid-cols-1 gap-[30px] md:grid-cols-2 lg:grid-cols-3"
        >
          <!-- Member -->
          <div
            class="rounded-main border border-white/20 bg-white/10 px-8 py-10 backdrop-blur-[5px] transition-all duration-300 hover:-translate-y-[10px] hover:shadow-membership"
          >
            <h3
              class="relative mb-6 pb-4 text-[1.5rem] font-bold text-white"
            >
              Member
              <span
                class="absolute bottom-0 left-1/2 h-[2px] w-[50px] -translate-x-1/2 bg-secondary"
              ></span>
            </h3>
            <p class="mb-8 text-[1rem] leading-[1.7] opacity-90">
              Attend events, join language sessions and social nights.
            </p>
            <a
              href="#contact"
              class="inline-block rounded-pill border-2 border-white bg-white px-7 py-3 text-[0.9rem] font-semibold uppercase tracking-[0.5px] text-primary transition-all duration-300 hover:bg-transparent hover:text-white"
            >
              Join Now
            </a>
          </div>

          <!-- Volunteer -->
          <div
            class="rounded-main border border-white/20 bg-white/10 px-8 py-10 backdrop-blur-[5px] transition-all duration-300 hover:-translate-y-[10px] hover:shadow-membership"
          >
            <h3
              class="relative mb-6 pb-4 text-[1.5rem] font-bold text-white"
            >
              Volunteer
              <span
                class="absolute bottom-0 left-1/2 h-[2px] w-[50px] -translate-x-1/2 bg-secondary"
              ></span>
            </h3>
            <p class="mb-8 text-[1rem] leading-[1.7] opacity-90">
              Help plan events, run workshops or manage communications.
            </p>
            <a
              href="#contact"
              class="inline-block rounded-pill border-2 border-white bg-white px-7 py-3 text-[0.9rem] font-semibold uppercase tracking-[0.5px] text-primary transition-all duration-300 hover:bg-transparent hover:text-white"
            >
              Get Involved
            </a>
          </div>

          <!-- Partner -->
          <div
            class="rounded-main border border-white/20 bg-white/10 px-8 py-10 backdrop-blur-[5px] transition-all duration-300 hover:-translate-y-[10px] hover:shadow-membership"
          >
            <h3
              class="relative mb-6 pb-4 text-[1.5rem] font-bold text-white"
            >
              Partner
              <span
                class="absolute bottom-0 left-1/2 h-[2px] w-[50px] -translate-x-1/2 bg-secondary"
              ></span>
            </h3>
            <p class="mb-8 text-[1rem] leading-[1.7] opacity-90">
              Organizations and cultural centers who want to collaborate.
            </p>
            <a
              href="#contact"
              class="inline-block rounded-pill border-2 border-white bg-white px-7 py-3 text-[0.9rem] font-semibold uppercase tracking-[0.5px] text-primary transition-all duration-300 hover:bg-transparent hover:text-white"
            >
              Partner With Us
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

<!-- Contact -->
<section id="contact" class="py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-bold text-center text-blue-900">Get In Touch</h2>

    <div class="mt-10 grid gap-12 grid-cols-1 md:grid-cols-2">
      <div>
        <h3 class="text-2xl font-semibold">Contact Information</h3>
        <p class="mt-4 text-gray-600"><i class="fas fa-envelope"></i> <a href="mailto:qazsociety@yahoo.com" class="text-blue-600">qazsociety@yahoo.com</a></p>
        <p class="mt-2 text-gray-600"><i class="fas fa-phone"></i> +32 (490) 21-54-12</p>
        <p class="mt-2 text-gray-600"><i class="fas fa-phone"></i> +7 (700) 007-07-80</p>
        <p class="mt-2 text-gray-600"><i class="fas fa-map-marker-alt"></i> Brussels, Belgium</p>

        <div class="mt-6">
          <h4 class="text-lg font-semibold">Follow Us</h4>
          <div class="mt-3 flex items-center gap-3">
            <a href="#" class="w-10 h-10 rounded-full bg-gray-100 text-blue-600 flex items-center justify-center"><i class="fab fa-facebook-f"></i></a>
            <a href="https://www.instagram.com/qazsociety.be/" class="w-10 h-10 rounded-full bg-gray-100 text-blue-600 flex items-center justify-center"><i class="fab fa-instagram"></i></a>
            <a href="https://www.linkedin.com/company/qazaq-society-in-belgium" class="w-10 h-10 rounded-full bg-gray-100 text-blue-600 flex items-center justify-center"><i class="fab fa-linkedin-in"></i></a>
            <a href="#" class="w-10 h-10 rounded-full bg-gray-100 text-blue-600 flex items-center justify-center"><i class="fab fa-youtube"></i></a>
          </div>

          <div class="mt-6 bg-blue-50 text-blue-700 p-4 rounded-lg border-l-4 border-yellow-400">
            <p class="text-sm"><i class="fas fa-language"></i> <strong>Multilingual Support</strong><br>
            We can provide information in Kazakh, Russian, Dutch, and French on request.</p>
          </div>
        </div>
      </div>

      <div>
        <h3 class="text-2xl font-semibold">Send Us a Message</h3>
        <form id="contactForm" class="mt-6 space-y-4">
          <div>
            <input type="text" id="name" name="name" placeholder="Your Name" required class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
          <div>
            <input type="email" id="email" name="email" placeholder="Your Email" required class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
          <div>
            <input type="text" id="subject" name="subject" placeholder="Subject" required class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
          <div>
            <textarea id="message" name="message" rows="5" placeholder="Your Message" required class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
          </div>
          <div>
            <button type="submit" class="px-6 py-3 rounded-full bg-blue-600 text-white font-semibold hover:bg-transparent hover:text-blue-600 border-2 border-blue-600 transition">Send Message</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
{{ end }}

{{ template "layout" . }}