{{ define "layout" }}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/assets/images/Qazaq-Society-Sign-Yellow.svg">
  <link rel="apple-touch-icon" href="/assets/images/Qazaq-Society-Sign-Yellow.svg">
  <link rel="shortcut icon" href="/assets/images/Qazaq-Society-Sign-Yellow.svg">

  <!-- Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <title>{{ block "title" . }}Qazaq Society{{ end }}</title>
</head>

<body class="antialiased text-gray-800 bg-white">

  {{ template "navbar" . }}

  <main>
      {{ block "content" . }}{{ end }}
  </main>

  {{ template "footer" . }}

</body>
</html>
{{ end }}
